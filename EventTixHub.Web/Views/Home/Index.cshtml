@model AfishaVM
@{
    ViewData["Title"] = "Афиш";
    var f = Model.Filter;
    var pager = new PagerVM(Model.Events.Page, Model.Events.TotalPages, Model.RouteValues());
    var cities = Model.Options.Cities.ToList();
    var moreActive = !string.IsNullOrEmpty(f.Search) || !string.IsNullOrEmpty(f.Genre) || f.VenueId is not null
        || f.Date is not null || f.Sort != EventSort.Date;
    var types = new (EventType? Value, string Label)[]
    {
        (null, "Всички"), (EventType.Movie, "Филми"), (EventType.Concert, "Концерти"), (EventType.Theatre, "Театър")
    };
}

<header class="masthead">
    <h1 class="display">Афиш</h1>
    @if (cities.Count > 0)
    {
        <p class="masthead-sub">Кино, концерти и театър @Format.CityPhrase(cities)</p>
    }
</header>

<form method="get" asp-action="Index" class="afisha-filters mb-4">
    <div class="filter-row">
        <nav class="chips" aria-label="Вид">
            @foreach (var (value, label) in types)
            {
                var route = pager.LinkFor(1); // applied filters, back to page 1
                if (value is null) route.Remove("Type"); else route["Type"] = value.Value.ToString();
                <a class="chip" asp-action="Index" asp-all-route-data="route" aria-current="@(f.Type == value ? "page" : null)">@label</a>
            }
        </nav>
        <input type="hidden" name="Type" value="@f.Type" />
        <div class="filter-city">
            <label for="f-city" class="visually-hidden">Град</label>
            <select name="City" id="f-city" class="form-select" data-autosubmit>
                <option value="">Всички градове</option>
                @foreach (var c in Model.Options.Cities)
                {
                    <option value="@c" selected="@(f.City == c)">@c</option>
                }
            </select>
        </div>
        <noscript><button type="submit" class="btn btn-primary">Покажи</button></noscript>    </div>

    <button type="button" class="btn btn-outline-secondary d-md-none mt-2" data-bs-toggle="collapse"
            data-bs-target="#more-filters" aria-expanded="@(moreActive ? "true" : "false")" aria-controls="more-filters">
        Още филтри
    </button>
    <div id="more-filters" class="collapse d-md-block @(moreActive ? "show" : "")">
        <div class="filter-row filter-row--more">
            <div>
                <label for="f-search" class="form-label">Търсене</label>
                <input type="search" name="Search" id="f-search" value="@f.Search" class="form-control" autocomplete="off" placeholder="напр. Дюна или рок…" data-autosubmit="blur" />
            </div>
            <div>
                <label for="f-genre" class="form-label">Жанр</label>
                <select name="Genre" id="f-genre" class="form-select" data-autosubmit>
                    <option value="">Всички жанрове</option>
                    @foreach (var g in Model.Options.Genres)
                    {
                        <option value="@g" selected="@(f.Genre == g)">@g</option>
                    }
                </select>
            </div>
            <div>
                <label for="f-venue" class="form-label">Зала</label>
                <select name="VenueId" id="f-venue" class="form-select" data-autosubmit>
                    <option value="">Всички зали</option>
                    @foreach (var v in Model.Options.Venues)
                    {
                        <option value="@v.Id" selected="@(f.VenueId == v.Id)">@v.Name</option>
                    }
                </select>
            </div>
            <div>
                <label for="f-date" class="form-label">Дата</label>
                <div class="date-field" data-placeholder="Всички дати">
                    <input type="date" name="Date" id="f-date" value="@Format.DateInput(f.Date)" class="form-control" data-autosubmit="blur" />
                </div>
            </div>
            <div>
                <label for="f-sort" class="form-label">Сортиране</label>
                <select name="Sort" id="f-sort" class="form-select" data-autosubmit>
                    <option value="Date" selected="@(f.Sort == EventSort.Date)">По дата</option>
                    <option value="Title" selected="@(f.Sort == EventSort.Title)">По заглавие</option>
                    <option value="Rating" selected="@(f.Sort == EventSort.Rating)">По оценка</option>
                </select>
            </div>
        </div>
    </div>
</form>

@if (Model.Events.Items.Count == 0)
{
    <div class="empty-state">
        <p class="mb-2">Няма събития по тези филтри.</p>
        <p class="text-muted">Опитайте друг град или дата.</p>
        <a class="btn btn-outline-secondary" asp-action="Index">Изчисти филтрите</a>
    </div>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 poster-wall mb-4">
        @foreach (var e in Model.Events.Items)
        {
            <div class="col">
                <partial name="_Poster" model="new PosterVM(e.Id, e.Title, e.Type, e.Genre, e.PosterUrl, e.NextShowtime, e.NextVenueName, e.NextCity, PosterSize.Card)" />
                @* Always rendered: a fixed-height row keeps the wall's rows level with or without price or rating. *@
                <div class="poster-meta">
                    @if (e.MinPrice is { } price)
                    {
                        <span class="poster-meta-price">от @Format.Money(price)</span>
                    }
                    @if (e.AverageRating is { } r)
                    {
                        <span class="poster-meta-rating"><span aria-hidden="true">★ @Format.Rating(r)</span><span class="visually-hidden">Оценка @Format.Rating(r) от 5</span></span>
                    }
                </div>
            </div>
        }
    </div>
    <partial name="_Pager" model="pager" />
}
