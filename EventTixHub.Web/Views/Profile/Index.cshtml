@model ProfileIndexVM
@{
    ViewData["Title"] = "Профил";
    var tabs = new[]
    {
        (TicketHistoryFilter.Upcoming, "Предстоящи"),
        (TicketHistoryFilter.Past, "Минали"),
        (TicketHistoryFilter.Cancelled, "Отказани")
    };
    var pager = new PagerVM(Model.Tickets.Page, Model.Tickets.TotalPages,
        new Dictionary<string, string?> { ["filter"] = Model.Filter.ToString() });
}

<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
    <div>
        <h1 class="headline">@Model.FullName</h1>
        <div class="text-muted">@Model.Email</div>
        <div class="text-muted">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Няма телефон" : Model.PhoneNumber)</div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Edit">Редакция</a>
</div>

<h2 class="h4">Моите билети</h2>
<ul class="nav nav-underline mb-3">
    @foreach (var (value, label) in tabs)
    {
        var active = Model.Filter == value;
        <li class="nav-item">
            <a class="nav-link @(active ? "active" : "")" asp-action="Index" asp-route-filter="@value" aria-current="@(active ? "page" : null)">@label</a>
        </li>
    }
</ul>

@if (Model.Tickets.Items.Count == 0)
{
    <p class="text-muted">Няма билети.</p>
}
else
{
    <ul class="list-unstyled profile-tickets">
        @foreach (var t in Model.Tickets.Items)
        {
            <li class="profile-ticket @t.EventType.TypeClass()">
                <div class="profile-date" aria-hidden="true"><span class="figure">@Format.PosterDay(t.StartsAt)</span><span class="label-caps">@Format.PosterMonth(t.StartsAt) · @Format.WeekdayShort(t.StartsAt)</span></div>
                <div>
                    <h3 class="h5 mb-1">@t.EventTitle <span class="badge type-badge">@t.EventType.DisplayName()</span></h3>
                    <div class="text-muted"><span class="visually-hidden">@Format.LongDate(t.StartsAt), @Format.Weekday(t.StartsAt), </span>@Format.Time(t.StartsAt) · @Format.Place(t.VenueName, t.City)</div>
                    <div>Ред @t.Row · място @t.Number</div>
                    <div class="text-nowrap-money fw-semibold">@Format.Money(t.Price)</div>
                    @if (Format.PromoNote(t.PromoCode, t.PromoPercent) is { } promo)
                    {
                        <div class="small text-muted">@promo</div>
                    }
                </div>
                <div class="profile-ticket-actions d-flex flex-wrap align-items-center gap-2">
                    <a class="btn @(Model.Filter == TicketHistoryFilter.Upcoming ? "btn-primary" : "btn-outline-secondary")" href="/Tickets/Details/@t.TicketId" aria-label="Покажи билета: ред @t.Row, място @t.Number, „@t.EventTitle“">Покажи билета</a>
                    <partial name="_CancelControl" model="t" />
                </div>
            </li>
        }
    </ul>
    <partial name="_Pager" model="pager" />
}
