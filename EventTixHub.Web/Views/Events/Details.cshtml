@model EventDetailsVM
@{
    var ev = Model.Details.Event;
    ViewData["Title"] = ev.Title;
    var pager = new PagerVM(Model.Reviews.Page, Model.Reviews.TotalPages, new Dictionary<string, string?>());
}

@{
    var first = Model.Details.Showtimes.FirstOrDefault();
    var noun = ev.Type.ShowtimeNoun(true);
}

<div class="details-hero">
    @* Decorative copy of the h1: hidden from assistive tech, and left out on phones so the programme sits higher. *@
    <div class="details-poster d-none d-md-block" aria-hidden="true">
        <partial name="_Poster" model="new PosterVM(ev.Id, ev.Title, ev.Type, ev.Genre, ev.PosterUrl, first?.StartsAt, first?.VenueName, first?.City, PosterSize.Hero, false)" />
    </div>
    <div class="details-facts">
        <h1 class="display">@ev.Title</h1>
        <p class="mt-3 mb-2">
            <span class="badge type-badge @ev.Type.TypeClass()">@ev.Type.DisplayName()</span>
            <span class="text-muted">· @ev.Genre · @ev.DurationMinutes мин.</span>
        </p>
        @if (Model.Details.AverageRating is { } avg)
        {
            <p class="mb-3"><span aria-hidden="true">★ </span><strong>@Format.Rating(avg) от 5</strong> <span class="text-muted">· @Model.Details.ReviewCount оценки</span></p>
        }
        <p class="details-desc">@ev.Description</p>
    </div>
</div>

<h2 class="headline programme-title">Предстоящи @noun</h2>
@if (Model.Details.Showtimes.Count == 0)
{
    <p class="text-muted mt-3">Няма предстоящи @noun.</p>
}
else
{
    <ol class="programme">
        @foreach (var s in Model.Details.Showtimes)
        {
            <li>
                <div class="programme-date" aria-hidden="true"><span class="figure">@Format.PosterDay(s.StartsAt)</span><span class="label-caps">@Format.PosterMonth(s.StartsAt) · @Format.WeekdayShort(s.StartsAt)</span></div>
                <div class="programme-when">
                    <span class="visually-hidden">@Format.LongDate(s.StartsAt), @Format.Weekday(s.StartsAt), </span><strong>@Format.Time(s.StartsAt)</strong>
                    <div>@s.VenueName, @s.City</div>
                </div>
                <div class="programme-price text-nowrap-money">@Format.Money(s.StandardPrice) · VIP @Format.Money(s.VipPrice)</div>
                <div class="programme-free">@s.FreeSeats свободни места</div>
                <div class="programme-action">
                    @if (s.FreeSeats > 0)
                    {
                        <a class="btn btn-primary" href="/Booking/Seats/@s.Id">Избери места</a>
                    }
                    else
                    {
                        <span class="label-caps">Изчерпани</span>
                    }
                </div>
            </li>
        }
    </ol>
}

<h2 class="headline programme-title mb-3">Оценки</h2>
@if (Model.CanReview)
{
    <form asp-controller="Reviews" asp-action="Add" method="post" class="card card-body review-form mb-4">
        <input type="hidden" name="EventId" value="@ev.Id" />
        <div class="mb-3">
            <label for="Rating" class="form-label">Оценка</label>
            <select id="Rating" name="Rating" class="form-select w-auto" required>
                @for (var i = 5; i >= 1; i--)
                {
                    <option value="@i">@i ★</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="Comment" class="form-label">Коментар</label>
            <textarea id="Comment" name="Comment" class="form-control" rows="3" maxlength="1000"></textarea>
        </div>
        <div><button type="submit" class="btn btn-primary">Добави оценка</button></div>
    </form>
}
else if (Model.CurrentUserId is null)
{
    <p class="text-muted">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Влезте</a>, за да оцените събитието.
    </p>
}
else if (!Model.CanReview)
{
    <p class="text-muted">Можете да оцените събитие само веднъж и само ако сте били с платен билет на негова прожекция, която вече е започнала.</p>
}

@if (Model.Reviews.Items.Count == 0)
{
    <p class="text-muted">Още няма оценки.</p>
}
else
{
    <ul class="reviews">
    @foreach (var r in Model.Reviews.Items)
    {
        <li>
            <div class="d-flex justify-content-between gap-3">
                <div>
                    <strong>@r.Author</strong>
                    <span class="review-stars" aria-hidden="true">@r.Rating/5 @string.Concat(Enumerable.Repeat("★", r.Rating))</span>
                    <span class="visually-hidden">Оценка @r.Rating от 5</span>
                </div>
                <div class="text-muted small">@r.CreatedAt.ToString("dd.MM.yyyy")</div>
            </div>
            @if (!string.IsNullOrEmpty(r.Comment))
            {
                <p class="mb-1">@r.Comment</p>
            }
            @if (r.UserId == Model.CurrentUserId || Model.IsAdmin)
            {
                <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id" method="post"
                      data-confirm="Да изтрием ли оценката на @r.Author?" onsubmit="return confirm(this.dataset.confirm);">
                    <input type="hidden" name="eventId" value="@ev.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                </form>
            }
        </li>
    }
    </ul>
    <div class="mt-3"><partial name="_Pager" model="pager" /></div>
}
