@model EventDetailsVM
@{
    var ev = Model.Details.Event;
    ViewData["Title"] = ev.Title;
    var pager = new PagerVM(Model.Reviews.Page, Model.Reviews.TotalPages, new Dictionary<string, string?>());
}

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        @if (!string.IsNullOrEmpty(ev.PosterUrl))
        {
            <img src="@ev.PosterUrl" class="img-fluid rounded" alt="@ev.Title" />
        }
        else
        {
            <div class="bg-secondary-subtle rounded d-flex align-items-center justify-content-center text-muted" style="height:300px">Без плакат</div>
        }
    </div>
    <div class="col-md-9">
        <h1 class="h3">@ev.Title</h1>
        <p>
            <span class="badge text-bg-primary">@ev.Type.DisplayName()</span>
            <span class="badge text-bg-light">@ev.Genre</span>
            <span class="text-muted">@ev.DurationMinutes мин.</span>
        </p>
        <p>
            @if (Model.Details.AverageRating is { } avg)
            {
                <strong>★ @avg.ToString("0.0")</strong> <span class="text-muted">(@Model.Details.ReviewCount оценки)</span>
            }
            else
            {
                <span class="text-muted">Още няма оценки</span>
            }
        </p>
        <p>@ev.Description</p>
    </div>
</div>

<h2 class="h4">Предстоящи прожекции</h2>
@if (Model.Details.Showtimes.Count == 0)
{
    <p class="text-muted">Няма предстоящи прожекции.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table align-middle">
            <thead>
                <tr><th>Начало</th><th>Зала</th><th>Град</th><th>Стандартен</th><th>VIP</th><th>Свободни места</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Details.Showtimes)
                {
                    <tr>
                        <td>@s.StartsAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@s.VenueName</td>
                        <td>@s.City</td>
                        <td>@s.StandardPrice.ToString("0.00") €</td>
                        <td>@s.VipPrice.ToString("0.00") €</td>
                        <td>@s.FreeSeats</td>
                        <td class="text-end">
                            @if (s.FreeSeats > 0)
                            {
                                <a class="btn btn-sm btn-primary" href="/Booking/Seats/@s.Id">Избери места</a>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Изчерпани</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Оценки</h2>
@if (Model.CanReview)
{
    <form asp-controller="Reviews" asp-action="Add" method="post" class="card card-body mb-4">
        <input type="hidden" name="EventId" value="@ev.Id" />
        <div class="mb-3">
            <label for="Rating" class="form-label">Оценка</label>
            <select id="Rating" name="Rating" class="form-select w-auto" required>
                @for (var i = 5; i >= 1; i--)
                {
                    <option value="@i">@i ★</option>
                }
            </select>
        </div>
        <div class="mb-3">
            <label for="Comment" class="form-label">Коментар</label>
            <textarea id="Comment" name="Comment" class="form-control" rows="3" maxlength="1000"></textarea>
        </div>
        <div><button type="submit" class="btn btn-primary">Добави оценка</button></div>
    </form>
}
else if (Model.CurrentUserId is null)
{
    <p class="text-muted">
        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Влезте</a>, за да оцените събитието.
    </p>
}
else if (!Model.CanReview)
{
    <p class="text-muted">Можете да оцените събитие само веднъж и само ако сте били с платен билет на негова прожекция, която вече е започнала.</p>
}

@if (Model.Reviews.Items.Count == 0)
{
    <p class="text-muted">Още няма оценки.</p>
}
else
{
    foreach (var r in Model.Reviews.Items)
    {
        <div class="border-bottom py-3">
            <div class="d-flex justify-content-between">
                <div><strong>@r.Author</strong> <span class="text-warning">@string.Concat(Enumerable.Repeat("★", r.Rating))</span></div>
                <div class="text-muted small">@r.CreatedAt.ToString("dd.MM.yyyy")</div>
            </div>
            @if (!string.IsNullOrEmpty(r.Comment))
            {
                <p class="mb-1">@r.Comment</p>
            }
            @if (r.UserId == Model.CurrentUserId || Model.IsAdmin)
            {
                <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id" method="post"
                      onsubmit="return confirm('Сигурни ли сте, че искате да изтриете оценката?');">
                    <input type="hidden" name="eventId" value="@ev.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                </form>
            }
        </div>
    }
    <div class="mt-3"><partial name="_Pager" model="pager" /></div>
}
