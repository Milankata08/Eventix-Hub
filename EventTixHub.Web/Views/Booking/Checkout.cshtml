@model CheckoutVM
@{
    ViewData["Title"] = "Плащане";
}

<h1 class="mb-3">Плащане</h1>

<partial name="_HoldBadge" model="new HoldBadgeVM(Model.SecondsLeft, true)" />

<div class="row">
    <div class="col-md-6 mb-4">
        <h2 class="h5">Поръчка</h2>
        @foreach (var g in Model.Cart.Lines.GroupBy(l => l.ShowtimeId))
        {
            var h = g.First();
            <section class="cart-group mb-3" aria-label="@h.EventTitle">
                <header class="cart-group-head">
                    <span class="badge type-badge @h.EventType.TypeClass()">@h.EventType.DisplayName()</span>
                    <h3 class="mb-0">@h.EventTitle</h3>
                    <div class="text-muted">@Format.LongDate(h.StartsAt) · @Format.Time(h.StartsAt) · @h.VenueName</div>
                </header>
                <ul class="list-unstyled mb-0">
                    @foreach (var l in g)
                    {
                        <li class="summary-line">
                            <span>Ред @l.Row · място @l.Number · @Format.Fare(l.Category, l.Concession)</span>
                            <span class="text-nowrap-money">@Format.Money(l.PriceBeforePromo)</span>
                        </li>
                    }
                </ul>
            </section>
        }
        <div class="px-3"><partial name="_PriceBreakdown" model="Model.Cart" /></div>
        <div class="summary-line fw-bold">
            <span>Общо</span>
            <span class="figure text-nowrap-money">@Format.Money(Model.Cart.Total)</span>
        </div>
        <a asp-action="Cart">Обратно към количката</a>
    </div>
    <div class="col-md-6">
        <h2 class="h5">Данни за картата</h2>
        <p class="text-muted small">Симулирано плащане: данните се проверяват и не се съхраняват.</p>
        <form asp-action="Checkout" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Payment.CardholderName" class="form-label"></label>
                <input asp-for="Payment.CardholderName" class="form-control" autocomplete="cc-name" />
                <span asp-validation-for="Payment.CardholderName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Payment.CardNumber" class="form-label"></label>
                <input asp-for="Payment.CardNumber" class="form-control" value="" inputmode="numeric" autocomplete="cc-number" />
                <span asp-validation-for="Payment.CardNumber" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Payment.Expiry" class="form-label"></label>
                    <input asp-for="Payment.Expiry" class="form-control" value="" placeholder="ММ/ГГ" inputmode="numeric" autocomplete="cc-exp" />
                    <span asp-validation-for="Payment.Expiry" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="Payment.Cvv" class="form-label"></label>
                    <input asp-for="Payment.Cvv" type="password" class="form-control" value="" inputmode="numeric" autocomplete="cc-csc" />
                    <span asp-validation-for="Payment.Cvv" class="text-danger"></span>
                </div>
            </div>
            <div class="pay-bar">
                <button type="submit" class="btn btn-primary w-100">Плати @Format.Money(Model.Cart.Total)</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/jquery-validation/dist/additional-methods.min.js"></script>
    <script>
        // No validation on blur: an error line appearing as the pointer leaves a field moves "Плати" and the
        // next field from under the click. Errors show on submit; after that, each input event updates the field's
        // error (input, not keyup, so autofill and pasting count too). Ready handler, so it runs after
        // jquery.validate.unobtrusive has built the form's validator. A failed submit always focuses the first error:
        // without a last-active field, focusInvalid falls back to errorList[0].
        $(() => {
            const form = $('form[action$="/Checkout"]'), validator = form.validate();
            validator.settings.onfocusout = validator.settings.onkeyup = false;
            validator.findLastActive = () => null;
            form.on('input', 'input', e => {
                if (e.target.name in validator.submitted || e.target.name in validator.invalid) validator.element(e.target);
            });
        });
    </script>
}
