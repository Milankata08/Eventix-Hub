@model CheckoutVM
@{
    ViewData["Title"] = "Плащане";
}

<h1 class="h3 mb-3">Плащане</h1>

<div class="row">
    <div class="col-md-6 mb-4">
        <h2 class="h5">Поръчка</h2>
        <ul class="list-group mb-2">
            @foreach (var l in Model.Cart.Lines)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>@l.EventTitle, ред @l.Row, място @l.Number</span>
                    <span>@Format.Money(l.Price)</span>
                </li>
            }
            <li class="list-group-item d-flex justify-content-between fw-bold">
                <span>Общо@(Model.Cart.PromoCode is null ? "" : $" (промо код {Model.Cart.PromoCode})")</span>
                <span>@Format.Money(Model.Cart.Total)</span>
            </li>
        </ul>
        <a asp-action="Cart">Обратно към количката</a>
    </div>
    <div class="col-md-6">
        <h2 class="h5">Данни за картата</h2>
        <p class="text-muted small">Симулирано плащане: данните се проверяват и не се съхраняват.</p>
        <form asp-action="Checkout" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Payment.CardholderName" class="form-label"></label>
                <input asp-for="Payment.CardholderName" class="form-control" />
                <span asp-validation-for="Payment.CardholderName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Payment.CardNumber" class="form-label"></label>
                <input asp-for="Payment.CardNumber" class="form-control" value="" inputmode="numeric" />
                <span asp-validation-for="Payment.CardNumber" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col mb-3">
                    <label asp-for="Payment.Expiry" class="form-label"></label>
                    <input asp-for="Payment.Expiry" class="form-control" value="" placeholder="ММ/ГГ" />
                    <span asp-validation-for="Payment.Expiry" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="Payment.Cvv" class="form-label"></label>
                    <input asp-for="Payment.Cvv" type="password" class="form-control" value="" inputmode="numeric" />
                    <span asp-validation-for="Payment.Cvv" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Плати @Format.Money(Model.Cart.Total)</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
