@model HallVM
@{
    var map = Model.Map;
    ViewData["Title"] = "Избор на места";
}

<div class="event-band @map.EventType.TypeClass()">
    <span class="badge type-badge">@map.EventType.DisplayName()</span>
    <h1 class="headline">@map.EventTitle</h1>
    <p class="mb-0">@Format.LongDate(map.StartsAt), @Format.Weekday(map.StartsAt) · @Format.Time(map.StartsAt) · @map.VenueName</p>
    <p class="text-muted mb-0">Стандартно @Format.Money(map.StandardPrice) · VIP @Format.Money(map.VipPrice)</p>
</div>

<partial name="_Hall" model="Model" />

@section Scripts {
    <script src="~/js/seatmap.js" asp-append-version="true"></script>
}
