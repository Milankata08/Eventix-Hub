@model CartVM
@{
    ViewData["Title"] = "Количка";
    var cart = Model.Cart;
    var promoCode = TempData["PromoCode"] as string;
    var promoError = TempData["PromoError"] as string;
    var hasLines = cart is { Lines.Count: > 0 };
}

<h1 class="mb-3">Количка</h1>

@if (cart is { ExpiredCount: > 0 })
{
    foreach (var g in cart.Expired.GroupBy(e => e.ShowtimeId))
    {
        var first = g.First();
        var seats = g.Select(e => $"ред {e.Row}, място {e.Number}").ToList();
        var seatText = seats.Count == 1 ? seats[0] : string.Join(", ", seats.Take(seats.Count - 1)) + " и " + seats[^1];
        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
            <span>Резервацията за @seatText („@first.EventTitle“, @Format.LongDate(first.StartsAt), @Format.Time(first.StartsAt)) изтече.</span>
            <a class="btn btn-primary" href="/Booking/Seats/@g.Key?seats=@string.Join(",", g.Select(e => e.SeatId))">Опитай отново със същите места</a>
        </div>
    }
}

@if (!hasLines)
{
    @if (cart is not { ExpiredCount: > 0 })
    {
        <p class="text-muted">Количката е празна.</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Към афиша</a>
    }
    else
    {
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Към афиша</a>
    }
}
else
{
    <partial name="_HoldBadge" model="new HoldBadgeVM(Model.SecondsLeft, true)" />

    <div class="row">
        <div class="col-lg-8">
            @foreach (var g in cart!.Lines.GroupBy(l => l.ShowtimeId))
            {
                var h = g.First();
                <section class="cart-group mb-4" aria-label="@h.EventTitle">
                    <header class="cart-group-head">
                        <span class="badge type-badge @h.EventType.TypeClass()">@h.EventType.DisplayName()</span>
                        <h2 class="mb-0">@h.EventTitle</h2>
                        <div class="text-muted">@Format.LongDate(h.StartsAt) · @Format.Time(h.StartsAt) · @h.VenueName</div>
                    </header>
                    <ul class="list-unstyled mb-0">
                        @foreach (var l in g)
                        {
                            <li class="cart-line">
                                <div class="cart-line-main">
                                    <div class="fw-semibold">Ред @l.Row · място @l.Number · @l.Category.DisplayName()</div>
                                    <form asp-action="SetConcession" method="post" class="d-flex flex-wrap align-items-end gap-2 mt-1">
                                        <input type="hidden" name="ticketId" value="@l.TicketId" />
                                        <div>
                                            <label class="form-label small mb-0" for="c-@l.TicketId">Намаление<span class="visually-hidden"> за ред @l.Row, място @l.Number</span></label>
                                            <select id="c-@l.TicketId" name="concession" class="form-select form-select-sm" data-autosubmit>
                                                @foreach (var c in Enum.GetValues<ConcessionType>())
                                                {
                                                    <option value="@c" selected="@(c == l.Concession)">@Format.Concession(c)</option>
                                                }
                                            </select>
                                        </div>
                                        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Приложи</button></noscript>
                                    </form>
                                </div>
                                <div class="cart-line-side">
                                    <div class="text-nowrap-money fw-bold">@Format.Money(l.Fare)</div>
                                    <form asp-action="RemoveTicket" method="post">
                                        <input type="hidden" name="ticketId" value="@l.TicketId" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0">Премахни<span class="visually-hidden"> ред @l.Row, място @l.Number</span></button>
                                    </form>
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }
            <p class="text-muted small">Студентската и пенсионерската карта се проверяват на входа.</p>

            <div class="mb-4">
                @if (cart.PromoCode is not null)
                {
                    <form asp-action="RemovePromo" method="post" class="d-flex align-items-center gap-2">
                        <span>Промо код <strong>@cart.PromoCode</strong> (−@cart.PromoPercent&nbsp;%): <span class="text-nowrap-money">−@Format.Money(cart.PromoDiscount)</span></span>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Премахни</button>
                    </form>
                }
                else
                {
                    <form asp-action="ApplyPromo" method="post" style="max-width: 22rem">
                        <label class="form-label" for="promo-code">Промо код</label>
                        <div class="d-flex gap-2">
                            <input id="promo-code" name="code" class="form-control" maxlength="20" value="@promoCode"
                                   aria-invalid="@(promoError is null ? "false" : "true")"
                                   aria-describedby="@(promoError is null ? null : "promo-error")" />
                            <button type="submit" class="btn btn-outline-primary">Приложи</button>
                        </div>
                        @if (promoError is not null)
                        {
                            <div id="promo-error" class="text-danger small mt-1">@promoError</div>
                        }
                    </form>
                }
            </div>
        </div>

        <aside class="col-lg-4 d-none d-lg-block">
            <div class="totals-panel">
                <partial name="_PriceBreakdown" model="cart" />
                <div class="label-caps@(cart.PromoCode is null ? "" : " mt-2")">Общо</div>
                <div class="figure text-nowrap-money mb-3">@Format.Money(cart.Total)</div>
                <a class="btn btn-primary w-100" asp-action="Checkout">Към плащане</a>
            </div>
        </aside>
    </div>

    <div class="totals-bar d-lg-none">
        <span class="fw-bold text-nowrap-money">Общо @Format.Money(cart.Total)</span>
        <a class="btn btn-primary" asp-action="Checkout">Към плащане</a>
    </div>
}
