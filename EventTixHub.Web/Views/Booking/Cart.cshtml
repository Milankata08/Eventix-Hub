@model CartVM
@{
    ViewData["Title"] = "Количка";
    var cart = Model.Cart;
}

<h1 class="h3 mb-3">Количка</h1>

@if (cart is { ExpiredCount: > 0 })
{
    <div class="alert alert-warning" role="alert">
        @(cart.ExpiredCount == 1 ? "1 билет е с изтекла резервация и беше премахнат." : $"{cart.ExpiredCount} билета са с изтекла резервация и бяха премахнати.")
        Изберете местата отново, ако още ги искате.
    </div>
}

@if (cart is null || cart.Lines.Count == 0)
{
    <p class="text-muted">
        @(cart is null ? "Количката е празна." : "Резервацията изтече или количката е празна. Изберете местата отново.")
    </p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Към афиша</a>
}
else
{
    <div class="alert alert-info" role="status">
        Местата са запазени за <strong data-countdown="@Model.SecondsLeft">@Model.SecondsLeft сек.</strong>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Събитие</th>
                    <th>Начало</th>
                    <th>Място</th>
                    <th>Намаление</th>
                    <th class="text-end">Цена</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in cart.Lines)
                {
                    <tr>
                        <td>@l.EventTitle<div class="text-muted small">@l.VenueName</div></td>
                        <td>@l.StartsAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>Ред @l.Row, място @l.Number (@l.Category.DisplayName())</td>
                        <td>
                            <form asp-action="SetConcession" method="post">
                                <input type="hidden" name="ticketId" value="@l.TicketId" />
                                <select name="concession" class="form-select form-select-sm" onchange="this.form.submit()"
                                        aria-label="Намаление за ред @l.Row, място @l.Number">
                                    @foreach (var c in Enum.GetValues<ConcessionType>())
                                    {
                                        <option value="@c" selected="@(c == l.Concession)">@c.DisplayName()@(c == ConcessionType.Student ? " −20%" : c == ConcessionType.Pensioner ? " −30%" : "")</option>
                                    }
                                </select>
                                <noscript><button type="submit" class="btn btn-sm btn-outline-secondary mt-1">Приложи</button></noscript>
                            </form>
                        </td>
                        <td class="text-end">@l.Price.ToString("0.00") €</td>
                        <td class="text-end">
                            <form asp-action="RemoveTicket" method="post">
                                <input type="hidden" name="ticketId" value="@l.TicketId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Премахни</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Общо</th>
                    <th class="text-end">@cart.Total.ToString("0.00") €</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
    <p class="text-muted small">Студентската и пенсионерската карта се проверяват на входа.</p>

    <div class="mb-4">
        @if (cart.PromoCode is not null)
        {
            <form asp-action="RemovePromo" method="post" class="d-flex align-items-center gap-2">
                <span>Промо код <strong>@cart.PromoCode</strong> (−@cart.PromoPercent%)</span>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Премахни</button>
            </form>
        }
        else
        {
            <form asp-action="ApplyPromo" method="post" class="d-flex gap-2" style="max-width: 22rem">
                <input name="code" class="form-control" placeholder="Промо код" maxlength="20" aria-label="Промо код" />
                <button type="submit" class="btn btn-outline-primary">Приложи</button>
            </form>
        }
    </div>

    <a class="btn btn-primary" asp-action="Checkout">Плащане</a>
}
