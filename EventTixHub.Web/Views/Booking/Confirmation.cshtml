@model ConfirmationVM
@{
    ViewData["Title"] = "Потвърждение";
    var groups = Model.Tickets.GroupBy(c => (c.Ticket.EventTitle, c.Ticket.StartsAt, c.Ticket.VenueName));
}

<p class="label-caps text-muted mb-3">Платено · поръчка @Format.OrderNo(Model.OrderId) · @Format.Money(Model.Total)</p>
<h1 class="visually-hidden">Потвърждение на поръчка @Format.OrderNo(Model.OrderId)</h1>

@foreach (var g in groups)
{
    var h = g.First().Ticket;
    <section class="invitation mb-4 @h.EventType.TypeClass()">
        <header class="invitation-head">
            <div class="label-caps">@h.EventType.InvitationLine()</div>
            <h2 class="display invitation-title">@h.EventTitle</h2>
            <div class="fs-5">@Format.LongDate(h.StartsAt), @Format.Weekday(h.StartsAt), @Format.Time(h.StartsAt)</div>
            <div class="text-muted">@h.VenueName · @h.VenueAddress, @h.City</div>
        </header>
        @foreach (var card in g)
        {
            <partial name="_TicketCard" model="card" view-data="@(new ViewDataDictionary(ViewData) { ["Nested"] = true })" />
        }
    </section>
}

<p class="text-muted">Представете QR кода на входа.</p>
<button type="button" class="btn btn-outline-secondary d-print-none" onclick="window.print()">Печат</button>
<a class="btn btn-primary d-print-none" asp-controller="Profile" asp-action="Index">Моите билети</a>
