@model UserTicketDto
@if (Model.CanCancel)
{
    var ask = $"Да откажем ли билета за ред {Model.Row}, място {Model.Number} — „{Model.EventTitle}“?";
    <form action="/Tickets/Cancel/@Model.TicketId" method="post" asp-antiforgery="true" class="d-inline"
          onsubmit="return confirm(@System.Text.Json.JsonSerializer.Serialize(ask));">
        <button type="submit" class="btn btn-outline-danger">Откажи</button>
    </form>
}
else if (Model.Status == TicketStatus.Paid && Model.StartsAt > DateTime.Now)
{
    <span class="text-muted small">Отказ е възможен до @BookingRules.CancellationDeadlineHours часа преди началото.</span>
}
