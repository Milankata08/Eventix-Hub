@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<section class="status-page">
    <p class="label-caps status-kicker">Грешка</p>
    <h1 class="display">Възникна грешка</h1>
    <p class="lead">Заявката не можа да бъде обработена. Опитайте отново след малко.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-secondary small">Номер на заявката: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Към афиша</a>
</section>
