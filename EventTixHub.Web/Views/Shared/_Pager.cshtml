@model PagerVM
@if (Model.TotalPages > 1)
{
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Страници">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="Model.LinkFor(Model.Page - 1)">‹ Предишна</a>
            </li>
            @for (var p = from; p <= to; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-all-route-data="Model.LinkFor(p)">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-all-route-data="Model.LinkFor(Model.Page + 1)">Следваща ›</a>
            </li>
        </ul>
    </nav>
}
