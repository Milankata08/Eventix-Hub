@model HallVM
@using EventTixHub.Web.Services
@using Microsoft.AspNetCore.Html
@{
    var map = Model.Map;
    var readOnly = Model.Monitor || Model.SalesClosed;
    var mode = Model.Monitor ? "monitor" : Model.SalesClosed ? "closed" : "select";
}

<div id="seatmap" class="hall-layout @(readOnly ? "" : "hall-layout--split") @(Model.SalesClosed ? "hall-layout--closed" : "") @map.EventType.TypeClass()" data-showtime-id="@map.ShowtimeId" data-mode="@mode"
     data-standard-price="@map.StandardPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
     data-vip-price="@map.VipPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
    <div class="hall-main">
        @if (Model.SalesClosed)
        {
            <div class="alert alert-warning" role="alert"><strong>Затворено:</strong> продажбата за @map.EventType.ShowtimeThis() @map.EventType.ShowtimeNoun() приключи.</div>
        }
        <div class="seat-legend mb-3">
            <span><i class="seat seat-free" aria-hidden="true"></i> свободно</span>
            @if (!readOnly)
            {
                <span><i class="seat seat-selected" aria-hidden="true"></i> избрано</span>
            }
            <span><i class="seat seat-held" aria-hidden="true"></i> резервирано</span>
            <span><i class="seat seat-sold" aria-hidden="true"></i> продадено</span>
            <span><i class="zone-swatch" aria-hidden="true"></i> VIP зона</span>
        </div>

        <div class="alert alert-warning d-none" data-role="status" role="status">Схемата не можа да се зареди. Опитваме отново…</div>
        <div class="alert alert-warning d-none" data-role="notice" role="alert"></div>

        <div class="hall-frame">
            <div class="hall-inner">
                @if (map.EventType == EventTixHub.Web.Models.EventType.Movie)
                {
                    <div class="hall-front hall-screen" aria-hidden="true">
                        <svg viewBox="0 0 400 28" preserveAspectRatio="none" focusable="false"><path d="M6 24 Q200 -10 394 24" fill="none" stroke="var(--type)" stroke-width="6" stroke-linecap="round" /></svg>
                        <span class="label-caps">@map.EventType.HallFront()</span>
                    </div>
                }
                else
                {
                    <div class="hall-front hall-stage" aria-hidden="true"><span class="label-caps">@map.EventType.HallFront()</span></div>
                }
                <div class="seat-grid" data-role="grid">
                    <p class="text-muted" data-role="loading">Зареждане на схемата…</p>
                </div>
            </div>
        </div>
        <p class="text-muted small mt-1 mb-0" data-role="scroll-hint" aria-hidden="true" hidden>Превъртете настрани, за да видите цялата зала.</p>

        <p class="text-muted small my-3">
            Свободни: <span data-count="free">@map.FreeCount</span> ·
            Резервирани: <span data-count="held">@map.HeldCount</span> ·
            Продадени: <span data-count="sold">@map.SoldCount</span>
            @if (Model.Monitor)
            {
                <text>(обновява се на всеки 5 секунди)</text>
            }
        </p>
    </div>

    @if (!readOnly)
    {
        <aside class="hall-summary" aria-label="Избрани места">
            <form asp-controller="Booking" asp-action="Reserve" method="post">
                <input type="hidden" name="showtimeId" value="@map.ShowtimeId" />
                <div class="summary-panel" data-role="panel" id="summary-panel">
                    <h2 class="headline h5">Избрани места</h2>
                    <p class="text-muted mb-2" data-role="empty">Още няма избрани места.</p>
                    <ul class="summary-list" data-role="list"></ul>
                    <p class="summary-total">Общо: <strong data-role="total">0,00&nbsp;€</strong></p>
                </div>
                <p class="small text-muted summary-promise">Ще пазим местата @BookingRules.HoldMinutes минути, докато платите. До @BookingRules.MaxTicketsPerOrder билета в поръчка.</p>
                @if (Model.Hold is { } hold)
                {
                    // The words that change with the count carry both forms, so seatmap.js can lower the count as holds end.
                    var one = hold.SecondsLeft.Count == 1;
                    Func<string, string, IHtmlContent> word = (single, plural) =>
                        new HtmlString($"<span data-one=\"{single}\" data-many=\"{plural}\">{(one ? single : plural)}</span>");
                    <p class="summary-held" data-hold-summary="@string.Join(' ', hold.SecondsLeft)">
                        Имате <span data-hold-count>@hold.SecondsLeft.Count</span> @word("място", "места")
                        @if (hold.ForThisShowtime)
                        {
                            <text>за @map.EventType.ShowtimeThis() @map.EventType.ShowtimeNoun() в количката, @word("отбелязано", "отбелязани") на схемата като „резервирано“.</text>
                        }
                        else
                        {
                            <text>в количката.</text>
                        }
                        <a href="/Booking/Cart">Към количката</a>
                    </p>
                }
                <div class="summary-bar">
                    <button type="button" class="btn btn-link summary-toggle d-lg-none" data-role="toggle" aria-expanded="false" aria-controls="summary-panel">
                        <span data-role="bar-text">0 места · 0,00 €</span>
                    </button>
                    <button type="submit" class="btn btn-primary" data-role="submit" disabled>Добави в количката</button>
                </div>
            </form>
            <div class="visually-hidden" role="status" aria-live="polite" data-role="announce"></div>
        </aside>
    }
</div>
