@model TicketCardVM
@{
    var t = Model.Ticket;
}
<article class="ticket @t.EventType.TypeClass()" aria-label="Билет за @t.EventTitle, ред @t.Row, място @t.Number">
    <div class="ticket-main">
        @if (ViewData["Nested"] is true)
        {
            <h3 class="h5 mb-1">@t.EventTitle</h3>
        }
        else
        {
            <h2 class="h5 mb-1">@t.EventTitle</h2>
        }
        <div class="text-muted">@Format.LongDate(t.StartsAt), @Format.Weekday(t.StartsAt) · @Format.Time(t.StartsAt) · @t.VenueName</div>
        <div class="figure ticket-seat my-3">Ред @t.Row · място @t.Number</div>
        <div>@Format.Fare(t.Category, t.Concession)</div>
        <div class="text-nowrap-money fw-semibold">@Format.Money(t.Price)</div>
        @if (Format.PromoNote(t.PromoCode, t.PromoPercent) is { } promo)
        {
            <div class="small text-muted">@promo</div>
        }
        @if (t.Status != TicketStatus.Paid)
        {
            <div class="label-caps mt-2">@t.Status.DisplayName()</div>
        }
    </div>
    <div class="ticket-stub">
        @if (Model.QrDataUri is not null)
        {
            <img class="ticket-qr" translate="no" src="@Model.QrDataUri" alt="QR код @t.Code" width="200" height="200" />
        }
        @if (t.Code is not null)
        {
            <div class="ticket-code" translate="no">@t.Code</div>
        }
    </div>
</article>
