@model AdminPromoCodesVM
@{
    ViewData["Title"] = "Промо кодове";
    var pager = new PagerVM(Model.Promos.Page, Model.Promos.TotalPages, new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["active"] = Model.Active?.ToString().ToLowerInvariant()
    });
}

<div class="page-head">
    <h1 class="headline">Промо кодове</h1>
    <a class="btn btn-primary" asp-action="Create">Нов промо код</a>
</div>

<form method="get" class="admin-filter">
    <div><label class="form-label label-caps" for="search">Търсене</label><input type="search" id="search" name="search" value="@Model.Search" class="form-control" data-autosubmit="blur" autocomplete="off" spellcheck="false" placeholder="напр. SUMMER10…" /></div>
    <div>
        <label class="form-label label-caps" for="active">Състояние</label>
        <select id="active" name="active" class="form-select" data-autosubmit>
            <option value="">Всички</option>
            <option value="true" selected="@(Model.Active == true)">Активни</option>
            <option value="false" selected="@(Model.Active == false)">Неизползваеми</option>
        </select>
    </div>
    <div class="admin-filter-actions">
        <button type="submit" class="btn btn-secondary">Търси</button>
    </div>
</form>

@if (Model.Promos.Items.Count == 0)
{
    <p class="text-muted">Няма намерени промо кодове.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Код</th><th class="num">Отстъпка</th><th class="num">Използван</th><th>Валиден</th><th>Състояние</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
        <tbody>
        @foreach (var p in Model.Promos.Items)
        {
            <tr>
                <td>@p.Code</td>
                <td class="num">@Format.Percent(p.DiscountPercent)</td>
                <td class="num">@p.TimesUsed / @p.UsageLimit</td>
                <td>@Format.Date(p.ValidFrom) – @Format.Date(p.ValidUntil)</td>
                <td class="label-caps">@Model.StateOf(p).DisplayName()</td>
                <td>
                    <div class="row-actions">
                        <a asp-action="Edit" asp-route-id="@p.Id">Редакция<span class="visually-hidden"> на „@p.Code“</span></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.Id">Изтрий<span class="visually-hidden"> „@p.Code“</span></a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="pager" />
}
