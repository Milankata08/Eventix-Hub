@model AdminEventDetailsVM
@{
    var e = Model.Event;
    ViewData["Title"] = e.Title;
}

<h1 class="headline">@e.Title</h1>
<p class="text-muted"><span class="badge type-badge @e.Type.TypeClass()">@e.Type.DisplayName()</span> · @e.Genre · @e.DurationMinutes мин</p>
@if (!string.IsNullOrWhiteSpace(e.Description))
{
    <p>@e.Description</p>
}
<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@e.Id">Редакция</a>
    <a class="btn btn-link" asp-action="Index">Към списъка</a>
</p>

<h2 class="label-caps mt-4">Прожекции</h2>
@if (Model.Showtimes.Count == 0)
{
    <p class="text-muted">Няма прожекции.</p>
}
else
{
    <div class="table-responsive">
    <table class="table">
        <thead><tr><th>Начало</th><th>Зала</th><th class="num">Продадени</th><th class="num">Резервирани</th><th class="num">Свободни</th></tr></thead>
        <tbody>
        @foreach (var s in Model.Showtimes)
        {
            <tr>
                <td><a asp-controller="Showtimes" asp-action="Details" asp-route-id="@s.Id">@s.StartsAt.ToString("dd.MM.yyyy HH:mm")</a></td>
                <td>@s.VenueName</td><td class="num">@s.Sold</td><td class="num">@s.Held</td><td class="num">@s.Free</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
