@model AdminEventsVM
@{
    ViewData["Title"] = "Събития";
    var pager = new PagerVM(Model.Events.Page, Model.Events.TotalPages, new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["type"] = Model.Type?.ToString(), ["genre"] = Model.Genre
    });
}

<div class="page-head">
    <h1 class="headline">Събития</h1>
    <a class="btn btn-primary" asp-action="Create">Ново събитие</a>
</div>

<form method="get" class="admin-filter">
    <div><label class="form-label label-caps" for="search">Търсене</label><input type="search" id="search" name="search" value="@Model.Search" class="form-control" data-autosubmit="blur" autocomplete="off" placeholder="напр. Хамлет или джаз…" /></div>
    <div>
        <label class="form-label label-caps" for="type">Вид</label>
        <select id="type" name="type" class="form-select" data-autosubmit>
            <option value="">Всички видове</option>
            @foreach (var t in Enum.GetValues<EventType>())
            {
                <option value="@t" selected="@(Model.Type == t)">@t.DisplayName()</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label label-caps" for="genre">Жанр</label>
        <select id="genre" name="genre" class="form-select" data-autosubmit>
            <option value="">Всички жанрове</option>
            @foreach (var g in Model.Options.Genres)
            {
                <option value="@g" selected="@(Model.Genre == g)">@g</option>
            }
        </select>
    </div>
    <div class="admin-filter-actions">
        <button type="submit" class="btn btn-secondary">Търси</button>
    </div>
</form>

@if (Model.Events.Items.Count == 0)
{
    <p class="text-muted">Няма намерени събития.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th class="admin-thumb"><span class="visually-hidden">Плакат</span></th><th>Заглавие</th><th>Вид</th><th>Жанр</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
        <tbody>
        @foreach (var e in Model.Events.Items)
        {
            <tr>
                <td><partial name="_Poster" model="new PosterVM(e.Id, e.Title, e.Type, e.Genre, e.PosterUrl, e.NextShowtime, e.NextVenueName, e.NextCity, PosterSize.Thumb, false)" /></td>
                <td>@e.Title</td>
                <td><span class="badge type-badge @e.Type.TypeClass()">@e.Type.DisplayName()</span></td>
                <td>@e.Genre</td>
                <td>
                    <div class="row-actions">
                        <a asp-action="Details" asp-route-id="@e.Id">Детайли<span class="visually-hidden"> на „@e.Title“</span></a>
                        <a asp-action="Edit" asp-route-id="@e.Id">Редакция<span class="visually-hidden"> на „@e.Title“</span></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id">Изтрий<span class="visually-hidden"> „@e.Title“</span></a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="pager" />
}
