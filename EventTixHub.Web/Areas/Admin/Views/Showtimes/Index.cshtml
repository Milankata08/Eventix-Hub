@model AdminShowtimesVM
@{
    ViewData["Title"] = "Прожекции";
    var f = Model.Filter;
    var pager = new PagerVM(Model.Showtimes.Page, Model.Showtimes.TotalPages, new Dictionary<string, string?>
    {
        ["eventId"] = f.EventId?.ToString(), ["venueId"] = f.VenueId?.ToString(),
        ["from"] = f.From?.ToString("yyyy-MM-dd"), ["to"] = f.To?.ToString("yyyy-MM-dd")
    });
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Прожекции</h1>
    <a class="btn btn-primary" asp-action="Create">Нова прожекция</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <select name="eventId" class="form-select" aria-label="Събитие">
            <option value="">Всички събития</option>
            @foreach (var e in Model.Events)
            {
                <option value="@e.Id" selected="@(f.EventId == e.Id)">@e.Title</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="venueId" class="form-select" aria-label="Зала">
            <option value="">Всички зали</option>
            @foreach (var v in Model.Venues)
            {
                <option value="@v.Id" selected="@(f.VenueId == v.Id)">@v.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2"><input type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="От дата" /></div>
    <div class="col-md-2"><input type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="До дата" /></div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary">Филтрирай</button>
        <a class="btn btn-link" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (Model.Showtimes.Items.Count == 0)
{
    <p class="text-muted">Няма намерени прожекции.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Събитие</th><th>Зала</th><th>Начало</th><th>Продадени</th><th>Резервирани</th><th>Свободни</th><th></th></tr></thead>
        <tbody>
        @foreach (var s in Model.Showtimes.Items)
        {
            <tr>
                <td>@s.EventTitle</td><td>@s.VenueName</td><td>@s.StartsAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@s.Sold</td><td>@s.Held</td><td>@s.Free</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.Id">Места</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id">Изтриване</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" model="pager" />
}
