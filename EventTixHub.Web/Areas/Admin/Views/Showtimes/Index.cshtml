@model AdminShowtimesVM
@{
    ViewData["Title"] = "Прожекции";
    var f = Model.Filter;
    var pager = new PagerVM(Model.Showtimes.Page, Model.Showtimes.TotalPages, new Dictionary<string, string?>
    {
        ["eventId"] = f.EventId?.ToString(), ["venueId"] = f.VenueId?.ToString(),
        ["from"] = f.From?.ToString("yyyy-MM-dd"), ["to"] = f.To?.ToString("yyyy-MM-dd")
    });
}

<div class="page-head">
    <h1 class="headline">Прожекции</h1>
    <a class="btn btn-primary" asp-action="Create">Нова прожекция</a>
</div>

<form method="get" class="admin-filter">
    <div>
        <label class="form-label label-caps" for="eventId">Събитие</label>
        <select id="eventId" name="eventId" class="form-select">
            <option value="">Всички събития</option>
            @foreach (var e in Model.Events)
            {
                <option value="@e.Id" selected="@(f.EventId == e.Id)">@e.Title</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label label-caps" for="venueId">Зала</label>
        <select id="venueId" name="venueId" class="form-select">
            <option value="">Всички зали</option>
            @foreach (var v in Model.Venues)
            {
                <option value="@v.Id" selected="@(f.VenueId == v.Id)">@v.Name</option>
            }
        </select>
    </div>
    <div><label class="form-label label-caps" for="from">От дата</label><input id="from" type="date" name="from" value="@f.From?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div><label class="form-label label-caps" for="to">До дата</label><input id="to" type="date" name="to" value="@f.To?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="admin-filter-actions">
        <button type="submit" class="btn btn-secondary">Филтрирай</button>
    </div>
</form>

@if (Model.Showtimes.Items.Count == 0)
{
    <p class="text-muted">Няма намерени прожекции.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Събитие</th><th>Зала</th><th>Начало</th><th class="num">Продадени</th><th class="num">Резервирани</th><th class="num">Свободни</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
        <tbody>
        @foreach (var s in Model.Showtimes.Items)
        {
            <tr>
                <td>@s.EventTitle <span class="badge type-badge @s.Type.TypeClass()">@s.Type.DisplayName()</span></td><td>@s.VenueName</td><td>@s.StartsAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="num">@s.Sold</td><td class="num">@s.Held</td><td class="num">@s.Free</td>
                <td>
                    <div class="row-actions">
                        <a asp-action="Details" asp-route-id="@s.Id">Места<span class="visually-hidden"> за „@s.EventTitle“, @s.StartsAt.ToString("dd.MM.yyyy HH:mm")</span></a>
                        <a asp-action="Edit" asp-route-id="@s.Id">Редакция<span class="visually-hidden"> на „@s.EventTitle“, @s.StartsAt.ToString("dd.MM.yyyy HH:mm")</span></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id">Изтрий<span class="visually-hidden"> „@s.EventTitle“, @s.StartsAt.ToString("dd.MM.yyyy HH:mm")</span></a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="pager" />
}
