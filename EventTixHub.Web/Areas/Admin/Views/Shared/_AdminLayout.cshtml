@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var current = ViewContext.RouteData.Values["controller"] as string;
    var items = new (string Controller, string Text)[]
    {
        ("Home", "Табло"), ("Events", "Събития"), ("Showtimes", "Прожекции"),
        ("Venues", "Зали"), ("PromoCodes", "Промо кодове"), ("Users", "Потребители"), ("Reports", "Справки")
    };
}

<ul class="nav nav-pills mb-4">
    @foreach (var (controller, text) in items)
    {
        <li class="nav-item">
            <a class="nav-link @(current == controller ? "active" : "")" asp-area="Admin" asp-controller="@controller" asp-action="Index">@text</a>
        </li>
    }
</ul>

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
