@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var current = ViewContext.RouteData.Values["controller"] as string;
    var items = new (string Controller, string Text)[]
    {
        ("Home", "Табло"), ("Events", "Събития"), ("Showtimes", "Прожекции"),
        ("Venues", "Зали"), ("PromoCodes", "Промо кодове"), ("Users", "Потребители"), ("Reports", "Справки")
    };
}

<nav aria-label="Администрация">
    <ul class="admin-tabs">
        @foreach (var (controller, text) in items)
        {
            <li><a asp-area="Admin" asp-controller="@controller" asp-action="Index" aria-current="@(current == controller ? "page" : null)">@text</a></li>
        }
    </ul>
</nav>

@RenderBody()

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
