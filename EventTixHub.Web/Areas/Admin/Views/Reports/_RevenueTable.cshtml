@model (string Title, IReadOnlyList<RevenueRowDto> Rows, string NameHeader)
@{
    var max = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(r => r.Revenue);
}

<h2 class="label-caps mt-4">@Model.Title</h2>
@if (Model.Rows.Count == 0)
{
    <p class="text-muted">Няма данни.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>@Model.NameHeader</th><th class="num">Билети</th><th class="col-bar">Приход</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            var percent = max == 0 ? 0 : (int)Math.Round(100 * r.Revenue / max);
            <tr>
                <td>@r.Name</td>
                <td class="num">@r.TicketsSold</td>
                <td>
                    @await Html.PartialAsync("_Bar", (percent, "Дял от най-големия приход"))
                    <div class="bar-note">@Format.Money(r.Revenue)</div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
