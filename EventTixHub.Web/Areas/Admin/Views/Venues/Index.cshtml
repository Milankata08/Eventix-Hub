@model AdminVenuesVM
@{
    ViewData["Title"] = "Зали";
    var pager = new PagerVM(Model.Venues.Page, Model.Venues.TotalPages, new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["city"] = Model.City
    });
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Зали</h1>
    <a class="btn btn-primary" asp-action="Create">Нова зала</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="search" value="@Model.Search" class="form-control" placeholder="Търсене по име или адрес" /></div>
    <div class="col-md-4">
        <select name="city" class="form-select" aria-label="Град">
            <option value="">Всички градове</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c" selected="@(Model.City == c)">@c</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-primary">Търси</button>
        <a class="btn btn-link" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (Model.Venues.Items.Count == 0)
{
    <p class="text-muted">Няма намерени зали.</p>
}
else
{
    <table class="table align-middle">
        <thead><tr><th>Име</th><th>Град</th><th>Адрес</th><th>Места</th><th></th></tr></thead>
        <tbody>
        @foreach (var v in Model.Venues.Items)
        {
            <tr>
                <td>@v.Name</td><td>@v.City</td><td>@v.Address</td><td>@(v.Rows * v.SeatsPerRow)</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.Id">Места</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@v.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.Id">Изтриване</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <partial name="_Pager" model="pager" />
}
