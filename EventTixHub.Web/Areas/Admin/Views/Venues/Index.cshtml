@model AdminVenuesVM
@{
    ViewData["Title"] = "Зали";
    var pager = new PagerVM(Model.Venues.Page, Model.Venues.TotalPages, new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["city"] = Model.City
    });
}

<div class="page-head">
    <h1 class="headline">Зали</h1>
    <a class="btn btn-primary" asp-action="Create">Нова зала</a>
</div>

<form method="get" class="admin-filter">
    <div><label class="form-label label-caps" for="search">Търсене</label><input id="search" name="search" value="@Model.Search" class="form-control" data-autosubmit="blur" placeholder="По име или адрес" /></div>
    <div>
        <label class="form-label label-caps" for="city">Град</label>
        <select id="city" name="city" class="form-select" data-autosubmit>
            <option value="">Всички градове</option>
            @foreach (var c in Model.Cities)
            {
                <option value="@c" selected="@(Model.City == c)">@c</option>
            }
        </select>
    </div>
    <div class="admin-filter-actions">
        <button type="submit" class="btn btn-secondary">Търси</button>
    </div>
</form>

@if (Model.Venues.Items.Count == 0)
{
    <p class="text-muted">Няма намерени зали.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Име</th><th>Град</th><th>Адрес</th><th class="num">Места</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
        <tbody>
        @foreach (var v in Model.Venues.Items)
        {
            <tr>
                <td>@v.Name</td><td>@v.City</td><td>@v.Address</td><td class="num">@(v.Rows * v.SeatsPerRow)</td>
                <td>
                    <div class="row-actions">
                        <a asp-action="Details" asp-route-id="@v.Id">Места<span class="visually-hidden"> в „@v.Name“</span></a>
                        <a asp-action="Edit" asp-route-id="@v.Id">Редакция<span class="visually-hidden"> на „@v.Name“</span></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@v.Id">Изтрий<span class="visually-hidden"> „@v.Name“</span></a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="pager" />
}
