@model VenueDetailsVM
@{
    var v = Model.Venue;
    ViewData["Title"] = v.Name;
}

<h1 class="headline">@v.Name</h1>
<p class="text-muted">@v.City, @v.Address · @v.Rows реда × @v.SeatsPerRow места</p>
<p>
    <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@v.Id">Редакция</a>
    <a class="btn btn-link" asp-action="Index">Към списъка</a>
</p>

<div class="seat-legend mb-3">
    <span><i class="seat seat-free" aria-hidden="true"></i> стандартно</span>
    <span><i class="zone-swatch" aria-hidden="true"></i> VIP зона</span>
</div>
<div class="venue-plan hall-frame">
    <div class="hall-inner">
        <div class="hall-front hall-stage" aria-hidden="true"><span class="label-caps">Екран / сцена</span></div>
        <div class="seat-grid mb-3">
            @foreach (var row in Model.Seats.GroupBy(s => s.Row))
            {
                var vip = row.First().Category == SeatCategory.Vip;
                <form asp-action="ToggleRowVip" asp-route-id="@v.Id" method="post" class="seat-row @(vip ? "zone-vip" : "")">
                    <input type="hidden" name="row" value="@row.Key" />
                    <span class="seat-row-label">@row.Key</span>
                    @foreach (var seat in row)
                    {
                        <span class="seat seat-free" title="Ред @seat.Row, място @seat.Number, @seat.Category.DisplayName()">@seat.Number</span>
                    }
                    <button type="submit" class="btn btn-sm btn-secondary">
                        <span aria-hidden="true">@(vip ? "Стандартен" : "VIP")</span><span class="visually-hidden">@(vip ? $"Направи ред {row.Key} стандартен" : $"Направи ред {row.Key} VIP")</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>
