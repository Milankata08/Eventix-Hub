@model VenueDetailsVM
@{
    var v = Model.Venue;
    ViewData["Title"] = v.Name;
}

<h1 class="h3">@v.Name</h1>
<p class="text-muted">@v.City, @v.Address · @v.Rows реда × @v.SeatsPerRow места</p>
<p>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@v.Id">Редакция</a>
    <a class="btn btn-link" asp-action="Index">Към списъка</a>
</p>

<div class="seat-legend mb-3">
    <span><i class="seat seat-free"></i> стандартно</span>
    <span><i class="seat seat-vip"></i> VIP</span>
</div>
<div class="text-center text-muted mb-2">ЕКРАН / СЦЕНА</div>
<div class="seat-grid mb-3">
    @foreach (var row in Model.Seats.GroupBy(s => s.Row))
    {
        <form asp-action="ToggleRowVip" asp-route-id="@v.Id" method="post" class="seat-row">
            <input type="hidden" name="row" value="@row.Key" />
            <span class="seat-row-label">@row.Key</span>
            @foreach (var seat in row)
            {
                <span class="seat @(seat.Category == SeatCategory.Vip ? "seat-vip" : "seat-free")"
                      title="Ред @seat.Row, място @seat.Number, @seat.Category.DisplayName()">@seat.Number</span>
            }
            <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">VIP ред</button>
        </form>
    }
</div>
