@model AdminUsersVM
@{
    ViewData["Title"] = "Потребители";
    var pager = new PagerVM(Model.Users.Page, Model.Users.TotalPages, new Dictionary<string, string?>
    {
        ["search"] = Model.Search, ["role"] = Model.Role
    });
    var roleNames = new Dictionary<string, string> { [Roles.Administrator] = "Администратор", [Roles.Customer] = "Клиент" };
}

<div class="page-head"><h1 class="headline">Потребители</h1></div>

<form method="get" class="admin-filter">
    <div><label class="form-label label-caps" for="search">Търсене</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="По име или имейл" /></div>
    <div>
        <label class="form-label label-caps" for="role">Роля</label>
        <select id="role" name="role" class="form-select">
            <option value="">Всички роли</option>
            @foreach (var (value, text) in roleNames)
            {
                <option value="@value" selected="@(Model.Role == value)">@text</option>
            }
        </select>
    </div>
    <div class="admin-filter-actions">
        <button type="submit" class="btn btn-secondary">Търси</button>
        <a class="btn btn-link" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (Model.Users.Items.Count == 0)
{
    <p class="text-muted">Няма намерени потребители.</p>
}
else
{
    <div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Име</th><th>Имейл</th><th>Роля</th><th><span class="visually-hidden">Действия</span></th></tr></thead>
        <tbody>
        @foreach (var u in Model.Users.Items)
        {
            var self = u.Id == Model.CurrentUserId;
            <tr>
                <td>@u.FullName</td>
                <td>@u.Email</td>
                <td>
                    <form asp-action="SetRole" asp-route-id="@u.Id" method="post" class="d-flex gap-2">
                        <select name="role" class="form-select form-select-sm w-auto" aria-label="Роля на @u.FullName" disabled="@self">
                            @foreach (var (value, text) in roleNames)
                            {
                                <option value="@value" selected="@(u.Role == value)">@text</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-secondary" disabled="@self">Промени<span class="visually-hidden"> ролята на @u.FullName</span></button>
                    </form>
                </td>
                <td>
                    <div class="row-actions">
                    @if (!self)
                    {
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">Изтрий<span class="visually-hidden"> @u.FullName</span></a>
                    }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
    <partial name="_Pager" model="pager" />
}
