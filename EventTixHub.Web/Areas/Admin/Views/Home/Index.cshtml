@model AdminDashboardVM
@{
    ViewData["Title"] = "Админ табло";
}

<div class="page-head"><h1 class="headline">Табло</h1></div>
<div class="kpis">
    <div><div class="label-caps">Приход днес</div><span class="figure">@Format.Money(Model.Kpis.RevenueToday)</span></div>
    <div><div class="label-caps">Приход този месец</div><span class="figure">@Format.Money(Model.Kpis.RevenueThisMonth)</span></div>
    <div><div class="label-caps">Продадени билети този месец</div><span class="figure">@Model.Kpis.TicketsSoldThisMonth</span></div>
</div>

<h2 class="headline h3">Предстоящи прожекции</h2>
@if (Model.Upcoming.Count == 0)
{
    <p class="text-muted mt-3">Няма предстоящи прожекции.</p>
}
else
{
    <ol class="programme-board">
        @foreach (var s in Model.Upcoming)
        {
            var percent = (int)Math.Round(s.Percent);
            <li class="@s.Type.TypeClass()">
                <div class="board-date">
                    <span class="figure">@Format.PosterDay(s.StartsAt)</span>
                    <span class="label-caps">@Format.PosterMonth(s.StartsAt)</span>
                </div>
                <div>
                    <div>
                        <a class="board-title" asp-controller="Showtimes" asp-action="Details" asp-route-id="@s.Id">@s.EventTitle</a>
                        <span class="badge type-badge @s.Type.TypeClass()">@s.Type.DisplayName()</span>
                    </div>
                    <div class="text-muted">@s.VenueName · @Format.Time(s.StartsAt)</div>
                    <div class="mt-2">@await Html.PartialAsync("_Bar", (percent, "Заетост"))</div>
                    <div class="bar-note">@Format.Percent(percent) · @s.Taken от @s.Capacity@if (s.IsCritical) { <text> · </text><span class="label-caps">критична</span> }</div>
                </div>
            </li>
        }
    </ol>
}
